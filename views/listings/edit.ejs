<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card form-card shadow-sm border-0 rounded-4">
            <div class="card-body p-3 p-sm-4 p-md-5">
                <h2 class="text-center fw-bold mb-4 form-title">Edit Listing</h2>

                <form
                    action="/listings/<%= listing._id %>?_method=PUT"
                    method="POST"
                    enctype="multipart/form-data"
                    class="needs-validation"
                    novalidate
                >
                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input
                            type="text"
                            id="title"
                            class="form-control form-control-custom"
                            name="listing[title]"
                            value="<%= listing.title %>"
                            placeholder="Enter listing title"
                            required
                        >
                        <div class="invalid-feedback">
                            Please enter a listing title.
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">
                            Description <span class="text-danger">*</span>
                        </label>
                        <textarea
                            id="description"
                            class="form-control form-control-custom"
                            name="listing[description]"
                            rows="4"
                            placeholder="Describe your property..."
                            required
                        ><%= listing.description %></textarea>
                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>
                    </div>

                    <!-- Current Image Preview -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Current Image</label>
                        <div class="img-preview-container rounded-3 overflow-hidden border">
                            <img
                                src="<%= listing.image.url %>"
                                alt="Current Image"
                                class="img-fluid current-img"
                            >
                        </div>
                    </div>

                    <!-- Upload New Image -->
                    <div class="mb-3">
                        <label for="image" class="form-label fw-semibold">
                            Upload New Image <span class="text-muted fw-normal">(Optional)</span>
                        </label>
                        <input
                            type="file"
                            id="image"
                            class="form-control form-control-custom"
                            name="listing[image]"
                            accept="image/*"
                        >
                    </div>

                    <!-- Price & Country -->
                    <div class="row">
                        <div class="col-12 col-sm-6 mb-3">
                            <label for="price" class="form-label fw-semibold">
                                Price (₹) <span class="text-danger">*</span>
                            </label>
                            <input
                                type="number"
                                id="price"
                                class="form-control form-control-custom"
                                name="listing[price]"
                                value="<%= listing.price %>"
                                min="0"
                                placeholder="1500"
                                required
                            >
                            <div class="invalid-feedback">
                                Please enter a valid price.
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 mb-3">
                            <label for="country" class="form-label fw-semibold">
                                Country <span class="text-danger">*</span>
                            </label>
                            <input
                                type="text"
                                id="country"
                                class="form-control form-control-custom"
                                name="listing[country]"
                                value="<%= listing.country %>"
                                placeholder="India"
                                required
                            >
                            <div class="invalid-feedback">
                                Please enter the country.
                            </div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="mb-3">
                        <label for="location" class="form-label fw-semibold">
                            Location <span class="text-danger">*</span>
                        </label>
                        <input
                            type="text"
                            id="location"
                            class="form-control form-control-custom"
                            name="listing[location]"
                            value="<%= listing.location %>"
                            placeholder="Goa"
                            required
                        >
                        <div class="invalid-feedback">
                            Please enter the location.
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="mb-4">
                        <label for="category" class="form-label fw-semibold">
                            Category
                        </label>
                        <select
                            id="category"
                            class="form-select form-control-custom"
                            name="listing[category]"
                            required
                        >
                            <% categories.forEach((category) => { %>
                                <option
                                    value="<%= category.name %>"
                                    <%= listing.category === category.name ? "selected" : "" %>
                                >
                                    <%= category.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex gap-2 gap-sm-3 flex-column flex-sm-row pt-2">
                        <button type="submit" class="btn btn-warning btn-lg rounded-3 flex-fill fw-bold py-2">
                            <i class="fa-solid fa-pen-to-square me-2"></i>
                            Update Listing
                        </button>

                        <a
                            href="/listings/<%= listing._id %>"
                            class="btn btn-outline-secondary btn-lg rounded-3 flex-fill fw-semibold py-2 text-center"
                        >
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>