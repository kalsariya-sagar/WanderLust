<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
    <!-- Main Listing Details Card -->
    <div class="col-12 col-lg-8">
        <div class="card show-card border-0 shadow-sm overflow-hidden rounded-4">
            
            <!-- Hero Image with Wishlist Button -->
            <div class="position-relative show-img-wrapper">
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="card-img-top show-img">
                
                <% if (currUser) { %>
                    <div class="wishlist-btn-wrapper">
                        <% if (wishlist.includes(listing._id.toString())) { %>
                            <form action="/wishlist/<%= listing._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="wishlist-icon active" aria-label="Remove from wishlist">
                                    <i class="fa-solid fa-heart"></i>
                                </button>
                            </form>
                        <% } else { %>
                            <form action="/wishlist/<%= listing._id %>" method="POST">
                                <button type="submit" class="wishlist-icon" aria-label="Add to wishlist">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                            </form>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <div class="card-body p-3 p-md-4">
                <!-- Title -->
                <h2 class="fw-bold mb-2 show-title"><%= listing.title %></h2>

                <!-- Location -->
                <p class="text-muted mb-3 fs-6">
                    <i class="fa-solid fa-location-dot text-danger me-2"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>

                <!-- Price -->
                <h4 class="price fw-bold text-dark mb-4">
                    ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %>
                    <span class="text-muted fs-6 fw-normal">/ night</span>
                </h4>

                <hr class="my-4">

                <!-- Host / Owner Info (If available) -->
                <% if (listing.owner) { %>
                    <div class="d-flex align-items-center mb-4">
                        <div class="host-avatar me-3">
                            <i class="fa-solid fa-user-circle fa-2x text-secondary"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Hosted by <%= listing.owner.username %></h6>
                        </div>
                    </div>
                    <hr class="my-4">
                <% } %>

                <!-- Description -->
                <h5 class="fw-bold mb-3">Description</h5>
                <p class="description text-secondary lh-base"><%= listing.description %></p>

                <!-- Owner Action Buttons -->
                <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                    <hr class="my-4">
                    <div class="d-flex gap-2 gap-sm-3 flex-wrap">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning flex-fill flex-sm-grow-0 px-4 py-2">
                            <i class="fa-solid fa-pen-to-square me-2"></i> Edit
                        </a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="flex-fill flex-sm-grow-0">
                            <button class="btn btn-danger w-100 px-4 py-2">
                                <i class="fa-solid fa-trash me-2"></i> Delete
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<% if (currUser) { %>
    <div class="row justify-content-center mt-4">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-3 p-md-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-4">Leave a Review</h4>

                    <form method="POST" action="/listings/<%= listing._id %>/reviews">
                        <!-- Rating -->
                        <div class="mb-4">
                            <fieldset class="starability-slot">
                                <legend class="form-label fw-semibold">Rating</legend>
                                <input type="radio" id="rate1" name="review[rating]" value="1">
                                <label for="rate1" title="Terrible">1 Star</label>
                                <input type="radio" id="rate2" name="review[rating]" value="2">
                                <label for="rate2" title="Not Good">2 Stars</label>
                                <input type="radio" id="rate3" name="review[rating]" value="3">
                                <label for="rate3" title="Average">3 Stars</label>
                                <input type="radio" id="rate4" name="review[rating]" value="4">
                                <label for="rate4" title="Very Good">4 Stars</label>
                                <input type="radio" id="rate5" name="review[rating]" value="5" checked>
                                <label for="rate5" title="Amazing">5 Stars</label>
                            </fieldset>
                        </div>

                        <!-- Comment -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Comment</label>
                            <textarea name="review[comment]" class="form-control rounded-3" rows="4" placeholder="Share your experience..." required></textarea>
                        </div>

                        <button class="btn btn-dark px-4 py-2 rounded-3">Submit Review</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
<% } %>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 p-3 p-md-4">
            <h4 class="fw-bold mb-3">Where you'll be</h4>
            <div 
                id="map" 
                class="rounded-3 shadow-sm"
                data-coordinates='<%- JSON.stringify(listing.geometry ? listing.geometry.coordinates : [77.2090, 28.6139]) %>'
                data-title="<%= listing.title %>" 
                data-location="<%= listing.location %>"
                data-country="<%= listing.country %>">
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-lg-8">
        <h4 class="fw-bold mb-4">All Reviews</h4>

        <% if (!listing.reviews || listing.reviews.length === 0) { %>
            <div class="alert alert-light border rounded-3 text-center text-muted py-3">
                No reviews yet. Be the first to review!
            </div>
        <% } else { %>
            <div class="row g-3">
                <% for (let review of listing.reviews) { %>
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm h-100 border-0 rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fa-solid fa-circle-user fa-2x me-2 text-secondary"></i>
                                    <div>
                                        <h6 class="card-title fw-bold mb-0"><%= review.author ? review.author.username : 'User' %></h6>
                                        <small class="text-muted"><%= review.createdAt ? review.createdAt.toDateString() : '' %></small>
                                    </div>
                                </div>

                                <p class="starability-result my-2" data-rating="<%= review.rating %>">
                                    Rated: <%= review.rating %> stars
                                </p>

                                <p class="card-text text-secondary mb-2"><%= review.comment %></p>

                                <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>