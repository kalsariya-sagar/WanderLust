<% layout("/layouts/boilerplate") %>

<%- include("../includes/filters.ejs") %>

<% if (typeof noResults !== "undefined" && noResults) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        <%= noResults %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4 page-header">
    <h2 class="fw-bold mb-0 page-title">Explore Stays</h2>
    <a href="/listings/new" class="btn btn-primary-custom d-none d-sm-inline-flex align-items-center">
        <i class="fa-solid fa-plus me-2"></i> Add Listing
    </a>
</div>

<div class="row g-4">
    <% for (const listing of allListings) { %>
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card listing-card h-100 border-0">
                
                <% if (currUser) { %>
                    <div class="wishlist-btn-wrapper">
                        <% if (wishlist.includes(listing._id.toString())) { %>
                            <form action="/wishlist/<%= listing._id %>?_method=DELETE" method="POST">
                                <button type="submit" class="wishlist-icon active" aria-label="Remove from wishlist">
                                    <i class="fa-solid fa-heart"></i>
                                </button>
                            </form>
                        <% } else { %>
                            <form action="/wishlist/<%= listing._id %>" method="POST">
                                <button type="submit" class="wishlist-icon" aria-label="Add to wishlist">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                            </form>
                        <% } %>
                    </div>
                <% } %>

                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="img-container">
                        <img 
                            src="<%= listing.image.url %>" 
                            alt="<%= listing.title %>" 
                            class="card-img-top listing-img"
                            loading="lazy"
                        >
                    </div>

                    <div class="card-body px-1 py-2">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title text-truncate fw-bold mb-1"><%= listing.title %></h5>
                        </div>

                        <p class="card-text text-muted small mb-1">
                            <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </p>

                        <p class="card-text mb-0 mt-2">
                            <span class="listing-price fw-bold text-dark fs-6" data-price="<%= listing.price %>">
                                ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %>
                            </span>
                            <span class="text-muted small">/ night</span>
                        </p>
                    </div>
                </a>
            </div>
        </div>
    <% } %>
</div>