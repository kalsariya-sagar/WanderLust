<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-4 my-md-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card form-card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">

                <!-- Page Heading -->
                <div class="text-center mb-4">
                    <i class="fa-solid fa-right-to-bracket fa-2x text-danger mb-2"></i>
                    <h2 class="fw-bold form-title mb-1">Welcome Back</h2>
                    <p class="text-muted small">Log in to manage your listings and bookings</p>
                </div>

                <!-- Login Form -->
                <form
                    method="POST"
                    action="/login"
                    class="needs-validation"
                    novalidate
                >
                    <!-- Username -->
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">
                            Username
                        </label>
                        <input
                            id="username"
                            type="text"
                            name="username"
                            class="form-control form-control-custom"
                            placeholder="Enter your username"
                            autocomplete="username"
                            required
                        >
                        <div class="invalid-feedback">
                            Please enter your username.
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">
                            Password
                        </label>
                        <input
                            id="password"
                            type="password"
                            name="password"
                            class="form-control form-control-custom"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >
                        <div class="invalid-feedback">
                            Please enter your password.
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="btn btn-primary-custom w-100 py-2 fw-bold rounded-3"
                        aria-label="Log in"
                    >
                        <i class="fa-solid fa-right-to-bracket me-2"></i>
                        Log In
                    </button>
                </form>

                <hr class="my-4 text-muted opacity-25">

                <!-- Signup Link -->
                <p class="text-center mb-0 small text-muted">
                    Don't have an account?
                    <a href="/signup" class="fw-bold text-danger text-decoration-none ms-1">
                        Sign Up
                    </a>
                </p>

            </div>
        </div>
    </div>
</div>