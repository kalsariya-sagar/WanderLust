<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-4 my-md-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
        <div class="card form-card shadow-sm border-0 rounded-4 text-center">
            <div class="card-body p-4 p-md-5">

                <div class="mb-3">
                    <i class="fa-solid fa-circle-exclamation text-danger display-1 opacity-75"></i>
                </div>

                <h2 class="fw-bold form-title mb-2">
                    Oops! Something Went Wrong
                </h2>

                <p class="text-secondary fs-6 mb-4 px-md-3">
                    <%= err && err.message ? err.message : 'An unexpected error occurred. Please try again later.' %>
                </p>

                <a href="/listings" class="btn btn-primary-custom px-4 py-2 rounded-3 fw-semibold">
                    <i class="fa-solid fa-house me-2"></i>
                    Back To Home
                </a>

            </div>
        </div>
    </div>
</div>