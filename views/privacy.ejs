<% layout("/layouts/boilerplate.ejs") %>

<div class="container my-4">
  <div class="legal-header text-center">
    <h1 class="legal-title">Privacy Policy</h1>
    <p class="text-muted">Last updated: July 2026</p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="legal-card">
        
        <div class="legal-section">
          <h2 class="legal-section-title">
            <i class="fa-solid fa-user-shield text-danger"></i> 1. Information We Collect
          </h2>
          <p class="legal-text">
            When you register on WanderLust, book a stay, or list a property, we collect personal information such as your name, email address, phone number, and account credentials.
          </p>
        </div>

        <div class="legal-section">
          <h2 class="legal-section-title">
            <i class="fa-solid fa-gears text-danger"></i> 2. How We Use Your Data
          </h2>
          <p class="legal-text">
            Your information is used strictly to provide and improve our platform services, process account registrations, display listing details, and enable secure communication between hosts and guests.
          </p>
          <ul class="legal-list">
            <li>To manage your user account and authentication.</li>
            <li>To allow property listing creation and review posts.</li>
            <li>To improve overall application performance and security.</li>
          </ul>
        </div>

        <div class="legal-section">
          <h2 class="legal-section-title">
            <i class="fa-solid fa-lock text-danger"></i> 3. Data Protection & Security
          </h2>
          <p class="legal-text">
            We employ industry-standard encryption and security measures to protect your credentials and session data stored in our database. We do not sell or rent your personal information to third parties.
          </p>
        </div>

        <div class="legal-section">
          <h2 class="legal-section-title">
            <i class="fa-solid fa-cookie-bite text-danger"></i> 4. Cookies & Sessions
          </h2>
          <p class="legal-text">
            WanderLust utilizes browser session storage and secure cookie mechanisms to preserve your login status and ensure seamless navigation across pages.
          </p>
        </div>

        <div class="legal-section">
          <h2 class="legal-section-title">
            <i class="fa-solid fa-envelope text-danger"></i> 5. Contact Us
          </h2>
          <p class="legal-text m-0">
            If you have questions regarding this Privacy Policy, feel free to reach out at <strong>privacy@wanderlust.com</strong>.
          </p>
        </div>

      </div>
    </div>
  </div>
</div>